# ---- Discord application (https://discord.com/developers/applications) ----
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-client-id
DISCORD_CLIENT_SECRET=your-application-client-secret

# Your own Discord user ID. Communities you create are auto-activated
# (no subscription needed) and you're treated as a member of every
# community for admin/testing purposes.
PLATFORM_OWNER_DISCORD_ID=your-discord-user-id

# Global fallback role IDs — apply to every community on top of whatever's
# granted per-community from the admin panel or /admin permissions. Mainly
# useful for the platform operator's own server(s). Comma-separated.
ADMIN_ROLE_IDS=
ADD_TIME_ROLE_IDS=

# ---- Website ----
# Must exactly match a redirect configured in the Discord Developer Portal
OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
SESSION_SECRET=change-this-to-a-long-random-string
PORT=3000
